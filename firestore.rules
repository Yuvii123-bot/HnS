rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName', 'gamesPlayed', 'seekerWins', 'hiderWins']) &&
             data.keys().hasOnly(['userId', 'displayName', 'photoURL', 'gamesPlayed', 'seekerWins', 'hiderWins', 'propsDestroyed', 'favoriteProp', 'updatedAt']) &&
             data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64 &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
             data.gamesPlayed is number && data.gamesPlayed >= 0 &&
             data.seekerWins is number && data.seekerWins >= 0 &&
             data.hiderWins is number && data.hiderWins >= 0 &&
             (!('propsDestroyed' in data) || (data.propsDestroyed is number && data.propsDestroyed >= 0)) &&
             (!('favoriteProp' in data) || (data.favoriteProp is string && data.favoriteProp.size() <= 64));
    }

    // Validation for LeaderboardEntry
    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['userId', 'displayName', 'score', 'wins']) &&
             data.keys().hasOnly(['userId', 'displayName', 'score', 'wins', 'updatedAt']) &&
             data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64 &&
             data.score is number && data.score >= 0 &&
             data.wins is number && data.wins >= 0;
    }

    // Validation for MatchHistory
    function isValidMatchHistory(data) {
      return data.keys().hasAll(['matchId', 'winnerTeam', 'durationSeconds', 'mapName', 'playersCount']) &&
             data.keys().hasOnly(['matchId', 'winnerTeam', 'durationSeconds', 'mapName', 'playersCount', 'createdBy', 'createdAt']) &&
             data.matchId is string && data.matchId.size() <= 128 &&
             (data.winnerTeam == 'hiders' || data.winnerTeam == 'seekers') &&
             data.durationSeconds is number && data.durationSeconds >= 0 &&
             data.mapName is string && data.mapName.size() <= 64 &&
             data.playersCount is number && data.playersCount >= 1 &&
             (!('createdBy' in data) || (data.createdBy is string && data.createdBy == request.auth.uid));
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
    }

    match /leaderboard/{userId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidLeaderboardEntry(incoming());
      allow delete: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
    }

    match /matches/{matchId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(matchId) && isValidMatchHistory(incoming());
      allow update, delete: if false; // Immutable match history
    }
  }
}
